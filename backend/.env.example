# Copy this file to .env only for local development. Do not commit a populated .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=bdelog_session
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
CSRF_HEADER_NAME=x-bdelog-csrf
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_one_time_seed_password
ADMIN_DISPLAY_NAME=Regional Sales Manager
